DATABASE_URL=postgresql+psycopg://taxrag:taxrag@localhost:5432/taxrag
TAXRAG_OBJECT_STORAGE_ROOT=var/object-storage
# Loaded automatically for local development. Never commit the real key.
# In Docker, CI, and production, real environment variables take precedence.
OPENAI_API_KEY=
TAXRAG_EMBEDDING_MODEL=text-embedding-3-small

# Answer pipeline (see docs/evals/README.md "Production Focus" and docs/evals/v1-results-rca.md).
# Production retrieval strategy: semantic | hybrid_rerank (candidate) | hybrid_rrf | lexical.
TAXRAG_ANSWER_STRATEGY=semantic
# Evidence chunks passed to the answer model.
TAXRAG_ANSWER_TOP_K=5
# LLM that reorders candidates for the hybrid_rerank strategy.
TAXRAG_RERANK_MODEL=gpt-4.1-mini
# Second-pass answer verifier (1 = on, 0 = off for ablation) and its model.
TAXRAG_ANSWER_VERIFICATION=1
TAXRAG_VERIFIER_MODEL=gpt-4.1-mini
